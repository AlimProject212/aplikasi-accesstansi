# Database
DATABASE_URL=mysql://user:password@host:3306/dbname

# JWT
JWT_SECRET=your_jwt_secret_here

# CORS
FRONTEND_URL=https://app.accesstansi.id

# Server
PORT=4000

# DOKU Payment Gateway
# Ambil dari: https://jokul.doku.com → Settings → Configuration
DOKU_CLIENT_ID=your-doku-client-id
DOKU_SECRET_KEY=your-doku-secret-key
DOKU_ENV=sandbox          # sandbox | production

# Backend URL (untuk DOKU callback/webhook — harus bisa diakses publik)
BACKEND_URL=http://localhost:4000

# Subscription Pricing (IDR) — 2 Tier
STARTER_PRICE_MONTHLY=79000
STARTER_PRICE_YEARLY=790000
PRO_PRICE_MONTHLY=149000
PRO_PRICE_YEARLY=1490000

# SMTP Email (for renewal reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=yourpassword
